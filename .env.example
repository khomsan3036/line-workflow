# ==========================================================
#  LINE Workflow Automation Workshop 2026 - ตัวอย่างไฟล์ config
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#  Windows:  copy .env.example .env
#  mac/Linux: cp .env.example .env
# ==========================================================

# ---------- 1) ฐานข้อมูล PostgreSQL ----------
# ในเครื่อง: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linechat

# ถ้าใช้ฐานข้อมูลบน cloud (Neon / Supabase / Render) ให้ใส่ ?sslmode=require ต่อท้าย
# ระบบจะเปิด SSL ให้อัตโนมัติเมื่อเจอ sslmode ใน URL
# ตัวอย่าง Neon (ใช้ connection string แบบ pooled ที่มีคำว่า -pooler):
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/linechat?sslmode=require
# DATABASE_SSL=true
# DATABASE_SSL_NO_VERIFY=false

# ---------- 1.1) ฐานข้อมูล HR (SQL Server) สำหรับสรุปพนักงานเข้างานจากเครื่องสแกนนิ้ว ----------
# ตาราง dbo.AttendanceDaily (ระบบ fingerprintsync เขียนให้) ปล่อยว่างได้ถ้ายังไม่ใช้
# ครอบค่าด้วย single quote เสมอ (รหัสผ่านมักมี $ ซึ่ง docker compose จะตีความเป็นตัวแปร)
# DATABASE_URL_MSSQL=Server=192.168.1.10\SQLEXPRESS;Database=HRDB;User Id=reader;Password=secret;TrustServerCertificate=True;
DATABASE_URL_MSSQL=''

# ---------- 1.2) API ระบบ HR สำหรับ "เวลาเข้างานของฉัน" (รายบุคคล ตาม prs_no) ----------
MANPOWER_API_URL=https://qtecintegra.com/api/hr/api/v1/Manpower/GetManpowerByDate
MANPOWER_API_TIMEOUT_MS=15000

# ---------- 1.3) ยืนยันตัวตนด้วย LINE Login สำหรับ "เวลาเข้างานของฉัน" ----------
# บอทจะแสดงเวลาเข้างานให้เฉพาะ LINE userId ที่ผูกกับรหัสพนักงานผ่าน LINE Login + บริการ auth กลางแล้ว
# (ส่งการ์ด "ยืนยันตัวตน" ตอนเพิ่มเพื่อน และตอนถามโดยยังไม่ยืนยัน)
# บริการยืนยันตัวตนกลาง QTEC (ชื่อแบบ NEXT_PUBLIC_* ของโปรเจกต์ qtec-integra ก็ใช้ได้)
AUTH_API_URL=https://qtecintegra.com/api/auth
EMP_AUTH_API_URL=https://qtecintegra.com/api/emp/auth
AUTH_API_TIMEOUT_MS=15000

# URL สาธารณะของแอปนี้ (ไม่มี / ท้าย) ใช้สร้างลิงก์ปุ่มในแชท
#   production: https://qtecintegra.com (คู่กับ BASE_PATH=/line-workflow)
#   ทดสอบในเครื่อง: URL ของ ngrok เช่น https://xxxx.ngrok-free.app
PUBLIC_URL=http://localhost:3000

# LINE Login channel (LINE Developers Console > provider เดียวกับ Messaging API channel > LINE Login)
# ใช้ channel เดียวกับ qtec-integra ได้ แต่ต้องเพิ่ม callback URL ของแอปนี้ในหน้า LINE Login ของ channel:
#   <PUBLIC_URL><BASE_PATH>/line-login/callback  เช่น https://qtecintegra.com/line-workflow/line-login/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# ระบุเองเมื่อ callback ไม่ได้อยู่ที่ <PUBLIC_URL><BASE_PATH>/line-login/callback
# LINE_LOGIN_CALLBACK_URL=
# อายุลิงก์ยืนยันตัวตนที่ส่งในแชท (นาที)
LINE_LOGIN_STATE_TTL_MINUTES=30
# true = userId จาก LINE Login ต้องตรงกับ userId ในแชท (channel ทั้งสองต้องอยู่ provider เดียวกัน)
# ตั้ง false เฉพาะเมื่ออยู่คนละ provider (userId ไม่ตรงกันโดยธรรมชาติ)
LINE_LOGIN_REQUIRE_SAME_USER=true

# true = อนุญาตให้พิมพ์รหัสพนักงานเองโดยไม่ยืนยันตัวตน (เฉพาะตอนพัฒนาที่ยังไม่มี LINE Login channel)
MY_ATTENDANCE_ALLOW_UNVERIFIED=false

# ใครกด "ดูรายชื่อ" ผลตรวจเทียบ bPlus บนการ์ดสรุปการเข้างานได้ (ต้องยืนยันตัวตนผ่าน LINE Login แล้ว)
# แผนกตามทะเบียน HR คั่นด้วยจุลภาค (ค่าเริ่มต้น HR) และ/หรือรหัสพนักงานรายคน เช่น S69-1-003
CROSS_CHECK_LIST_DEPTS=HR
CROSS_CHECK_LIST_PRS_NOS=

# จำนวน connection สูงสุดใน pool (ปกติไม่ต้องแก้)
PG_POOL_MAX=10

# ---------- 2) เซิร์ฟเวอร์ ----------
PORT=3000
TZ=Asia/Bangkok
# เมื่อ dashboard อยู่หลัง reverse proxy ใต้ prefix (เช่น https://qtecintegra.com/line-workflow/)
# ให้ตั้ง BASE_PATH=/line-workflow  ปล่อยว่างเมื่อรันที่ root ตามปกติ
# webhook (/webhook) และ /health อยู่ที่ root เสมอ ไม่ขึ้นกับค่านี้
BASE_PATH=
# development เมื่อรันในเครื่อง / production เมื่อ deploy จริง
NODE_ENV=development

# ---------- 3) LINE Messaging API ----------
# ได้จาก LINE Developers Console > Channel ของคุณ
# Basic settings   -> Channel secret
# Messaging API    -> Channel access token (long-lived)
# OA หลัก (HR Notification) - ใช้ชื่อ CHANNEL_ACCESS_TOKEN/CHANNEL_SECRET แบบเดิมก็ได้
CHANNEL_ACCESS_TOKEN_HR=
CHANNEL_SECRET_HR=

# ---------- 3.1) OA ที่สอง: ทีมซ่อมบำรุง (Maintenance Team) ----------
# แชทบอทถาม-ตอบข้อมูลซ่อมบำรุง/น้ำมัน/รถ โดย Claude เรียก tool จาก MCP server ของระบบ maintenance
# webhook ของ OA นี้อยู่ที่ POST /webhook/mt (ผ่าน gateway: https://qtecintegra.com/api/line-workflow/webhook/mt)
# ปล่อยว่างทั้งคู่ = ปิดฟีเจอร์นี้  (ต้องมี OPENAI_API_KEY หรือ ANTHROPIC_API_KEY ในข้อ 5 ด้วย)
CHANNEL_ACCESS_TOKEN_MT=
CHANNEL_SECRET_MT=
# ไม่มี OA MT แยก อยากให้ OA HR ตัวเดียวตอบทั้งเรื่อง HR และแชทบอทซ่อมบำรุง: ตั้ง true
# (หรือใส่ CHANNEL_ACCESS_TOKEN_MT เป็นค่าเดียวกับ CHANNEL_ACCESS_TOKEN_HR ระบบจะเปิดโหมดนี้ให้เอง)
# โหมดนี้ใช้ webhook /webhook ตัวเดียว: ข้อความ 1:1 ที่ไม่ใช่เรื่องเข้างานและไม่ตรงเมนู จะส่งให้แชทบอทซ่อมบำรุงตอบ
# ในกลุ่มต้องพิมพ์ @ผู้ช่วย/@บอท นำหน้า และการ์ดแจ้งเตือน/รายงาน MT จะส่งเข้ากลุ่มที่ OA HR อยู่ (line_groups.channel = hr)
MAINTENANCE_USE_HR_OA=false
# MCP server (Streamable HTTP) ของระบบซ่อมบำรุง
MAINTENANCE_MCP_URL=https://qtecintegra.com/maintenance/mcp
# header เพิ่มเติมถ้า MCP server ต้องการ เช่น "Authorization: Bearer xxx" (ปล่อยว่างถ้าไม่ต้อง)
# MAINTENANCE_MCP_AUTH_HEADER=
MAINTENANCE_MCP_TIMEOUT_MS=60000
# URL หน้าเว็บระบบซ่อมบำรุง (ไม่มี / ท้าย) การ์ดแจ้งเตือนในกลุ่มจะมีปุ่ม "เปิดหน้าอนุมัติ" ชี้ไปที่นี่ ปล่อยว่าง = ไม่มีปุ่ม
# MAINTENANCE_WEB_URL=https://qtecintegra.com
# แจ้งเตือนเอกสารใกล้หมดอายุ (ป้ายภาษี/พ.ร.บ., ประกันภัย, ปจ., สติ๊กเกอร์, ใบขับขี่)
#   MT_DOC_EXPIRY_CRON = รอบเวลา (ว่าง = ปิด) ค่าเริ่มต้น 09:30 ทุกวัน ตาม TZ
#   MAINTENANCE_API_URL = maintenance-asset-service ที่จะสั่ง dispatch (ไม่มี / ท้าย, ว่าง = ปิดงานนี้)
#     dev: http://localhost:5111   production (docker network เดียวกัน): http://maintenance-asset-service:8080
#   MAINTENANCE_DOC_EXPIRY_TIMEOUT_MS = เวลาที่ยอมรอ asset service (ค่าเริ่มต้น 120000)
MT_DOC_EXPIRY_CRON=30 9 * * *
MAINTENANCE_API_URL=
# MAINTENANCE_DOC_EXPIRY_TIMEOUT_MS=120000
# จำกัด tool ที่บอทเรียกได้ คั่นด้วยจุลภาค รองรับ * ท้ายชื่อ เช่น Get* = อ่านอย่างเดียว ไม่ส่งแจ้งเตือน (ค่าเริ่มต้น * = ทุก tool)
# MAINTENANCE_MCP_TOOLS=Get*
# ผู้ให้บริการโมเดล (โปรเจกต์นี้ใช้ OpenAI เป็นหลัก โมเดลตาม OPENAI_MODEL ในข้อ 5)
#   openai = ใช้ OpenAI เท่านั้น | auto = OpenAI ก่อน ถ้า key/เครดิตใช้ไม่ได้และมี ANTHROPIC_API_KEY จะสลับไป Claude ให้เอง
#   anthropic = ใช้ Claude เท่านั้น
MAINTENANCE_AI_PROVIDER=openai
# โมเดล Claude (ใช้เฉพาะเมื่อ provider เป็น anthropic/auto) และความละเอียดในการคิด low | medium | high | xhigh | max
MAINTENANCE_AI_MODEL=claude-opus-5
MAINTENANCE_AI_EFFORT=medium
# จำนวนรอบเรียก tool สูงสุดต่อคำถาม / จำนวนคู่ถาม-ตอบก่อนหน้าที่จำ / อายุประวัติ (นาที) / เวลารวมสูงสุดต่อคำถาม (ms)
MAINTENANCE_AI_MAX_TOOL_ROUNDS=8
MAINTENANCE_AI_HISTORY_PAIRS=6
MAINTENANCE_AI_HISTORY_MAX_AGE_MINUTES=120
MAINTENANCE_AI_TIMEOUT_MS=120000
# true = log ผลลัพธ์ tool และคำตอบดิบของโมเดลลง console (ใช้ตอนดีบัก)
MAINTENANCE_DEBUG=false

# ---------- 3.2) รับ event จากระบบซ่อมบำรุง (RabbitMQ) แล้วแจ้งเข้าไลน์กลุ่มด้วย OA MT ----------
# ระบบซ่อมบำรุง publish event ลง topic exchange "maintenance" (repair.requested, fuel.requested,
# vehicle.booking.requested และ maintenance.*.notification จาก MCP server) แต่ไม่มีตัวส่งเข้า LINE
# แอปนี้จึงรับมาแปลงเป็นการ์ดแล้ว push เข้ากลุ่มของทีมซ่อมบำรุง (ดู MT_ALERT_GROUP_IDS ด้านล่าง)
# ปล่อยว่าง = ปิด   รูปแบบ: amqp://user:password@host:5672/   (production: host 192.168.2.13)
RABBITMQ_URL=
MAINTENANCE_EXCHANGE=maintenance
MAINTENANCE_EVENT_QUEUE=line-workflow.maintenance-alerts
MAINTENANCE_EVENT_ROUTING_KEYS=maintenance.line.notification,repair.requested,fuel.requested,vehicle.booking.requested
# กันการ์ดซ้ำ: tool Get* ของ MCP server (GetCriticalAlerts, GetOverallSummary, GetExecutiveDashboard ...) publish alert เดิม
# ซ้ำทุกครั้งที่มีคนถามแชทบอท (ฝั่งนั้นกันซ้ำแค่ 60 นาทีและอยู่ในหน่วยความจำ) แอปนี้จึงจำคีย์ตามเนื้อหาไว้ในตาราง
# maintenance_alert_dedupe แล้วไม่ส่ง alert/คำขอเดิมซ้ำภายในกี่ชั่วโมง (0 = ปิด)
MAINTENANCE_EVENT_DEDUPE_HOURS=24
# true = ข้าม alert อัตโนมัติที่เกิดจากคำถามของแอปนี้เอง (requestedBy เป็น line:U... หรือ scheduler) เพราะผู้ถาม/กลุ่มได้การ์ดคำตอบ
# อยู่แล้ว ไม่ต้องได้การ์ดเดียวกันอีกชุด   false = ส่งทุก alert (ยังกันซ้ำตาม MAINTENANCE_EVENT_DEDUPE_HOURS)
MAINTENANCE_EVENT_SKIP_OWN_ANALYSIS=true

# --- ระบบรับเรื่องร้องเรียน (complaint-system) ---
# ใช้ RABBITMQ_URL เดียวกัน รับจาก exchange complaint.events แล้วส่งการ์ดด้วย OA HR ไปยัง recipients ที่ Complaint.Api ระบุมา
# จากนั้น publish complaint.notification.result กลับ   ปิดได้ด้วย COMPLAINT_EVENTS_ENABLED=false
COMPLAINT_EVENT_EXCHANGE=complaint.events
COMPLAINT_EVENT_QUEUE=line-workflow.complaint
# กันการ์ดเดิมซ้ำ (เลขที่เรื่อง + ชนิด) ภายในกี่ชั่วโมง ใช้ตาราง maintenance_alert_dedupe ร่วมกัน
COMPLAINT_EVENT_DEDUPE_HOURS=1
# ปุ่ม "รับเรื่อง" บนการ์ด / ผู้ร้องพิมพ์ "ติดตาม CP-… 123456" / การ์ดสรุปเรื่องค้าง — ต้องเรียก Complaint.Api ด้วย service token
COMPLAINT_API_URL=http://complaint-api:5324
COMPLAINT_SERVICE_TOKEN=
# สรุปเรื่องร้องเรียนค้าง (cron, Asia/Bangkok) -> กลุ่ม/บุคคล คั่นด้วยจุลภาค   ว่าง = ปิด
COMPLAINT_DIGEST_CRON=0 9 * * 1-5
COMPLAINT_DIGEST_GROUP_IDS=
# --- ใบขอเบิก/ขอยืมของสโตร์ (qtec-integra: Store Control → Request Issue) ---
# รับ store.request.* จาก exchange integra-drawing แล้วส่งการ์ดด้วย OA HR   ไม่ตั้ง STORE_REQUEST_LINE_TARGETS = ปิด
# broker ของ integra (ว่าง = ใช้ RABBITMQ_URL) — dev บนเครื่องเดียวกับ integra: amqp://rabbitmq:<รหัส>@localhost:5672/
#   production (แอปรันใน Docker): ห้ามใช้ localhost เพราะใน container คือตัวมันเอง -> ต่อไม่ติด ("เชื่อมต่อ RabbitMQ ไม่ได้ ()")
#   broker ของ integra อยู่บนเครื่อง Windows เดียวกัน (เปิดพอร์ต 5672): amqp://rabbitmq:<รหัส>@host.docker.internal:5672/
#   อยู่เครื่องอื่นใน LAN: amqp://rabbitmq:<รหัส>@192.168.2.x:5672/   เป็น broker ตัวเดียวกับ RABBITMQ_URL: ปล่อยว่าง
STORE_EVENTS_RABBITMQ_URL=
STORE_EVENT_EXCHANGE=integra-drawing
STORE_EVENT_QUEUE=line-workflow.store-request
# ปลายทาง C… (กลุ่มทีมสโตร์) / U… (บุคคล ใช้ทดสอบ) คั่นด้วยจุลภาค
STORE_REQUEST_LINE_TARGETS=
# ชนิดที่ส่ง: submitted (ยื่น) | approved (อนุมัติแล้ว รอจ่าย) | rejected | fulfilled (จ่ายแล้ว) | cancelled | all
STORE_REQUEST_LINE_EVENTS=approved,fulfilled,cancelled
# หน้าเว็บ qtec-integra ที่ปุ่มบนการ์ดเปิด (/store-control?view=request&tab=queue) ต้องเป็น https
STORE_REQUEST_WEB_URL=https://qtecintegra.com/integra
# กันการ์ดเดิมซ้ำ (เลขใบขอ + ชนิด) ภายในกี่ชั่วโมง
STORE_REQUEST_DEDUPE_HOURS=24
# กลุ่มปลายทางของการ์ดแจ้งเตือน MT (ทั้ง event จาก RabbitMQ และคำสั่ง "แจ้งเข้ากลุ่ม" ในแชทบอท)
#   MT_ALERT_GROUP_IDS = groupId คั่นด้วยจุลภาค (C...) ว่าง = เลือกตามชื่อกลุ่ม (ไม่เกี่ยวกับ MT_REPORT_GROUP_IDS ที่ใช้ทดสอบรายงาน)
#   MT_GROUP_KEYWORDS  = เลือกเฉพาะกลุ่มที่บอทอยู่และชื่อมีคำใดคำหนึ่ง (ไม่สนตัวพิมพ์) เช่น "MT Team", "ทีมซ่อมบำรุง"
#                        คำอังกฤษต้องเป็นคำเต็ม ("MT Team", "QTEC-MT" ตรง แต่ "Comtech" ไม่ตรง) คำไทยขอแค่มีอยู่ในชื่อ
# กลุ่มที่ชื่อไม่ตรงจะไม่ได้รับการ์ดเลย แม้บอทจะอยู่ในกลุ่มนั้น (ไม่มีการถอยไปส่งทุกกลุ่ม) ถ้าไม่มีกลุ่มไหนตรงจะขึ้น warn ใน log
# กลุ่มที่อยากให้รับแต่ชื่อไม่มีคำเหล่านี้ ให้ใส่ groupId ใน MT_ALERT_GROUP_IDS แทน
MT_ALERT_GROUP_IDS=
MT_GROUP_KEYWORDS=MT,ซ่อมบำรุง,maintenance

# โหมดจำลอง: true = ไม่ยิง API จริง แค่บันทึก log (ใช้ทดสอบ dashboard ก่อนมี LINE OA)
# ตั้งเป็น false เมื่อพร้อมส่งเข้า LINE จริง
MOCK_LINE=true

# groupId ปลายทางเริ่มต้น (ขึ้นต้นด้วย C...) ปล่อยว่างได้ ระบบจะเลือกจาก dropdown ให้
# สคริปต์และตัวตั้งเวลาจะใช้ค่านี้เมื่อไม่ได้ระบุ --group
# ตอนซ้อมด้วยข้อมูลจำลอง (npm run seed:chat) ใส่กลุ่มผู้บริหารจำลองได้เลย:
#   DEFAULT_GROUP_ID=Cdemo000000000000000000000000002
DEFAULT_GROUP_ID=

# ---------- 4) Admin Dashboard ----------
ADMIN_USERNAME=admin
# ใช้รหัสผ่านแบบข้อความธรรมดา (สะดวกตอนเรียน) หรือทำ hash ด้วย npm run hash-password
# ค่า hash ขึ้นต้นด้วย $2b$10$ ต้องครอบ single quote เสมอ ไม่งั้น docker compose จะตีความ $ เป็นตัวแปร
ADMIN_PASSWORD=admin1234
ADMIN_PASSWORD_HASH=''
# ตอน deploy จริงให้เปลี่ยนเป็นข้อความสุ่มยาว ๆ (เช่น openssl rand -base64 32)
SESSION_SECRET=change-this-to-a-long-random-string

# เก็บ session ลง PostgreSQL (ค่าเริ่มต้น: เปิดเมื่อ NODE_ENV=production)
# ถ้าไม่เปิด ล็อกอินจะหลุดทุกครั้งที่เซิร์ฟเวอร์ restart
# SESSION_IN_DATABASE=true

# อยู่หลัง reverse proxy เช่น Render / Nginx / Cloudflare (ค่าเริ่มต้น: เปิดเมื่อ production)
# TRUST_PROXY=true

# ส่ง cookie เฉพาะผ่าน HTTPS (ค่าเริ่มต้น: เปิดเมื่อ production)
# ถ้าต้องรัน production ผ่าน http ล้วน ให้ตั้งเป็น false ไม่งั้นจะล็อกอินไม่ได้
# COOKIE_SECURE=true

# ---------- 5) AI สรุปบทสนทนา (ไม่ใส่ก็ได้) ----------
# ลำดับการเลือก: OpenAI -> Claude -> rule-based ในเครื่อง
# ถ้าไม่ใส่ทั้งคู่ ระบบจะใช้ตัวสรุปแบบ rule-based ในเครื่องแทน (ทำงานได้ แต่ไม่ฉลาดเท่า)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ใส่เฉพาะเมื่อต้องการใช้ Claude แทน OpenAI (ต้องเว้น OPENAI_API_KEY ว่างไว้)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------- 6) Capstone: เกณฑ์แจ้งเตือนรายการผิดปกติ ----------
ANOMALY_AMOUNT_THRESHOLD=300000

# ---------- 7) เก็บไฟล์จากไลน์กลุ่มถาวร (Workshop 6) ----------
# LINE ระบุว่าไฟล์ที่ผู้ใช้ส่งจะถูกลบอัตโนมัติหลังผ่านไประยะหนึ่ง (ไม่บอกว่ากี่วัน)
# ระบบจึงดาวน์โหลดมาเก็บไว้เองทันทีที่ webhook เข้ามา
MEDIA_ARCHIVE_ENABLED=true

# local = เก็บลงดิสก์ในเครื่อง (ค่าเริ่มต้น) | s3 = เก็บขึ้น object storage
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=storage/media

# (เฉพาะตอนรันด้วย docker-compose.prod.yml บน Windows Server) โฟลเดอร์จริงบนเครื่อง host
# ที่ compose จะ bind mount เข้ามาเป็น /app/storage ใน container - ตัว app ไม่ได้อ่านค่านี้
# ใช้ / แทน \ ได้ และไม่ต้องครอบเครื่องหมายคำพูด ค่าเริ่มต้น D:/QTEC/File_Storage/LineWorkflow
# MEDIA_HOST_DIR=D:/QTEC/File_Storage/LineWorkflow

# ไม่โหลดไฟล์ที่ใหญ่เกินนี้ (MB) กันดิสก์เต็มโดยไม่ตั้งใจ
MEDIA_MAX_SIZE_MB=25
# ชนิดที่จะเก็บ: image, video, audio, file
MEDIA_TYPES=image,video,audio,file
# เก็บภาพย่อไว้แสดงในแกลเลอรีด้วย (ประหยัดแบนด์วิดท์)
MEDIA_SAVE_PREVIEW=true

# ถ้าจะเก็บขึ้น Cloudflare R2 / AWS S3 / MinIO (ต้อง npm install @aws-sdk/client-s3 ก่อน)
# MEDIA_STORAGE_DRIVER=s3
# S3_BUCKET=line-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------- 8) ตัวตั้งเวลาในตัวโปรแกรม ----------
# ใช้แทน Windows Task Scheduler เมื่อ deploy บน cloud ที่รันค้างตลอด (เช่น Render Starter)
# ในคลาส/ในเครื่องตัวเอง ให้ปิดไว้ (false / true) แล้วใช้ Task Scheduler ตาม Workshop 5
ENABLE_SCHEDULER=false
# รูปแบบ cron 5 ช่อง: นาที ชั่วโมง วันที่ เดือน วันในสัปดาห์ (เวลาตาม TZ ด้านบน)
SUMMARY_CRON=0 18 * * *
# REPORT_CRON = ส่งการ์ด "สรุปการเข้างาน" (จำนวนพนักงานสแกนเข้างานจากเครื่องสแกนนิ้ว ต้องตั้ง DATABASE_URL_MSSQL)
# แนะนำหลังเวลาเข้ากะสักครู่ เช่น 08:30 จะได้เห็นคนที่สแกนเข้าแล้วครบ
# หลายรอบต่อวันคั่นด้วย ; (ห้ามใช้จุลภาค) เช่น วันละ 2 รอบ 10:30 และ 20:00: REPORT_CRON=30 10 * * *;0 20 * * *
REPORT_CRON=0 8 * * *
# ปลายทางของการ์ดสรุปการเข้างาน คั่นด้วยจุลภาค (C... = กลุ่ม, U... = ผู้ใช้ ใส่ userId ตัวเองไว้ทดสอบก่อนได้)
# ว่าง = ใช้ DEFAULT_GROUP_ID
#
# แต่ละกลุ่มได้การ์ดของตัวเองได้ โดยต่อท้าย id ด้วยเครื่องหมาย :
#   C123            เดาแผนกจากชื่อกลุ่มในทะเบียน (QTEC_INTEGRA_STORE -> การ์ดแผนก Store แยกตามตำแหน่ง)
#                   ชื่อกลุ่มไม่ตรงแผนกไหน = การ์ดภาพรวมทุกแผนก แยกตามสถานที่
#   C123:Store      บังคับแผนก Store (ใช้เมื่อชื่อกลุ่มสะกดไม่ตรงกับทะเบียน HR)
#   C123:all        บังคับการ์ดภาพรวม (กลุ่ม HR / ผู้บริหาร ที่ต้องเห็นทั้งบริษัท)
# เช่น REPORT_GROUP_IDS=C_hr:all,C_store,C_procurement,C_maintenance:Maintenance
REPORT_GROUP_IDS=
# ช่วงเวลาที่สรุป: today | yesterday | thisWeek | lastWeek | thisMonth | lastMonth
REPORT_PERIOD=today
# สถานที่: all | workshop | site
REPORT_LOCATION=all
# --- OA ทีมซ่อมบำรุง (ต้องตั้ง CHANNEL_ACCESS_TOKEN_MT ก่อน) ---
# การ์ด "งานซ่อมค้างวันนี้" ทุกเช้า (ว่าง = ปิด)
MT_PENDING_CRON=30 8 * * *
# การ์ด "แจ้งเตือนงานซ่อมเร่งด่วน" ตรวจตามรอบ ส่งเฉพาะเมื่อมีเรื่องด่วนจริง (ว่าง = ปิด)
MT_URGENT_CRON=0 10,14 * * *
# ปลายทางของการ์ดรายงาน MT (งานค้าง/เร่งด่วน) คั่นด้วยจุลภาค (C... กลุ่ม / U... ผู้ใช้) ใช้ชี้ไปกลุ่มทดสอบได้
# ว่าง = กลุ่มของทีมซ่อมบำรุงตาม MT_ALERT_GROUP_IDS / MT_GROUP_KEYWORDS   ค่านี้ไม่มีผลกับการ์ดแจ้งเตือน (event / แจ้งเข้ากลุ่ม)
MT_REPORT_GROUP_IDS=
# "สรุปประชุมกลุ่มวันนี้" ของกลุ่ม MT ใช้ SUMMARY_CRON ด้านบน (ส่งด้วย OA ของกลุ่มนั้นเอง)
# การ์ด "Top OT สะสม" แยก Workshop / Site (ข้อมูล OT จาก bPlus ต้องตั้ง DATABASE_URL_MSSQL)
# OT_REPORT_CRON ค่าเริ่มต้นทุกวันจันทร์ 10:30 (หลัง sync bPlus รอบ 10:00) ว่าง = ปิด
# OT_REPORT_GROUP_IDS = ปลายทางคั่นด้วยจุลภาค (C... กลุ่ม / U... ผู้ใช้ทดสอบ) ว่าง = ไม่ส่ง
# OT_REPORT_PERIOD = lastWeek | thisWeek | lastMonth | thisMonth, OT_REPORT_TOP = จำนวนอันดับต่อสถานที่ (1-10)
OT_REPORT_CRON=30 10 * * 1
OT_REPORT_GROUP_IDS=
OT_REPORT_PERIOD=lastWeek
OT_REPORT_TOP=10
# กลุ่มที่พิมพ์ถามอันดับ "OT สัปดาห์นี้" ได้ (ว่าง = กลุ่ม C... ใน OT_REPORT_GROUP_IDS) แชท 1:1 ดูได้เฉพาะ OT ของตัวเอง
OT_ALLOWED_GROUP_IDS=
# การ์ด "ขาดงานติดต่อกัน" แยก Workshop / Site: พนักงานสถานะยังทำงาน (MANPOWER_HR) ที่ไม่สแกนนิ้วติดกัน >= ABSENCE_MIN_DAYS วันทำงาน
#   วันทำงาน = จ.-ส. ที่ไม่ใช่วันหยุดบริษัท (ดูจากจำนวนคนสแกน) ตรวจถึงเมื่อวาน
#   ABSENCE_REPORT_CRON ค่าเริ่มต้น จ.-ส. 09:00 ว่าง = ปิด / ABSENCE_REPORT_GROUP_IDS (C... กลุ่ม / U... ผู้ใช้ทดสอบ) ว่าง = ไม่ส่ง
#   ABSENCE_ACTIVE_DAYS = ไม่สแกนเกินกี่วันถือว่าออกไปแล้ว (ไม่แสดงชื่อ แสดงเป็นจำนวนให้ HR ตรวจสถานะ)
ABSENCE_REPORT_CRON=0 9 * * 1-6
ABSENCE_REPORT_GROUP_IDS=
ABSENCE_MIN_DAYS=2
ABSENCE_ACTIVE_DAYS=14
# ABSENCE_REPORT_TOP = รายชื่อต่อสถานที่บนการ์ด (คนที่ขาดนานสุด, ค่าเริ่มต้น 10) ตัวเลขภาพรวมนับทุกคน
ABSENCE_REPORT_TOP=10

# การ์ด "มาสายติดต่อกัน" แยก Workshop / Site: พนักงานสถานะยังทำงาน ที่สแกนแรกของวันหลังเวลาเข้างานทุกวันที่มาทำงาน >= LATE_MIN_DAYS วัน
#   นับย้อนจากวันทำงานล่าสุด (ถึงเมื่อวาน) วันที่มาตรงเวลาตัดความต่อเนื่อง วันที่ไม่มา (หยุด/ลา) ข้ามไป
#   LATE_REPORT_CRON ค่าเริ่มต้น จ.-ส. 09:05 ว่าง = ปิด / LATE_REPORT_GROUP_IDS (C... กลุ่ม / U... ผู้ใช้ทดสอบ) ว่าง = ไม่ส่ง
#   LATE_WORKSHOP_TIME / LATE_SITE_TIME = เวลาเข้างาน (สายตั้งแต่นาทีถัดไป เช่น 08:01)
#   LATE_MAX_TIME = สแกนแรกตั้งแต่เวลานี้ไม่นับว่าสาย (มักลืมสแกนเช้าแล้วมาสแกนตอนพักเที่ยง)
LATE_REPORT_CRON=5 9 * * 1-6
LATE_REPORT_GROUP_IDS=C67c06b7c76453f33475161d06d2d8c4a
LATE_MIN_DAYS=2
LATE_REPORT_TOP=10
LATE_WORKSHOP_TIME=08:00
LATE_SITE_TIME=07:40
LATE_MAX_TIME=10:00

# การ์ด "พนักงานเข้างานดีเด่นประจำเดือน" แยก Workshop / Site: ไม่ขาด (สแกนครบทุกวันทำงาน) ไม่สาย (สแกนแรกไม่เกิน LATE_*_TIME ทุกวัน)
#   ไม่ลา (ไม่มีวันลาใน bPlus ทั้งเดือน) เรียงจากมาก่อนเวลาเฉลี่ยมากสุด การ์ดชื่นชม ส่งเข้ากลุ่มพนักงานได้
#   PERFECT_REPORT_CRON ค่าเริ่มต้นวันที่ 1 ของเดือน 09:10 (สรุปเดือนที่แล้ว) ว่าง = ปิด / PERFECT_REPORT_GROUP_IDS ว่าง = ไม่ส่ง
#   ลองดู: npm run perfect-attendance -- --to=U... --month=2026-09
PERFECT_REPORT_CRON=10 9 1 * *
PERFECT_REPORT_GROUP_IDS=
PERFECT_REPORT_TOP=10

# ประกาศ "Monthly Cleaning Day" (วันเสาร์สุดท้ายของเดือน) การ์ด gradient ส่งตามรอบ CLEANING_DAY_CRON (ค่าเริ่มต้น 08:00 และ 17:00)
#   แจ้งล่วงหน้า CLEANING_DAY_DAYS_BEFORE วัน (3 -> แจ้งเตือน 1/3, 2/3, 3/3) + วันเสาร์นั้น (เช้า "วันนี้" / เย็น "ขอบคุณ")
#   ผ่านวันเสาร์สุดท้ายแล้วหยุด จนถึงช่วงแจ้งของเดือนหน้า   ดูตาราง: npm run cleaning-day -- --schedule
#   CLEANING_DAY_GROUP_IDS = ปลายทางคั่นด้วยจุลภาค (C... กลุ่ม / U... ผู้ใช้ทดสอบ) ว่าง = ปิด
#   CLEANING_DAY_MESSAGE = ข้อความประกาศ (ว่าง = ข้อความมาตรฐาน)
CLEANING_DAY_CRON=0 8,17 * * *
CLEANING_DAY_DAYS_BEFORE=3
# เวลาเริ่มกิจกรรมวันเสาร์นั้น และแจ้ง "อีก N นาทีเริ่ม" ก่อนกี่นาที (15:30 - 15 = ส่ง 15:15) 0 = ปิดรอบนี้
CLEANING_DAY_START_TIME=15:30
CLEANING_DAY_START_LEAD_MIN=15
CLEANING_DAY_GROUP_IDS=
CLEANING_DAY_MESSAGE=