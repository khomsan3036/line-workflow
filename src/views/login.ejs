<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>เข้าสู่ระบบ · QTEC LINE Workflow Admin</title>
  <link rel="icon" type="image/png" href="<%= base %>/images/qtecLogo.png">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body{font-family:'IBM Plex Sans Thai',system-ui,sans-serif}
    /* พื้นหลังไล่เฉดน้ำเงินเข้ม + แสงนวลสองจุด ให้ดูมีมิติแต่ไม่แย่งความสนใจจากฟอร์ม */
    .bg-scene{
      background:
        radial-gradient(60% 50% at 15% 10%, rgba(6,199,85,.18) 0%, transparent 60%),
        radial-gradient(50% 45% at 85% 90%, rgba(43,49,140,.45) 0%, transparent 60%),
        linear-gradient(160deg, #0C1628 0%, #101C36 55%, #0C1628 100%);
    }
    .logo-badge{ box-shadow: 0 18px 40px -18px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.06) inset }
    .card{ box-shadow: 0 30px 60px -25px rgba(0,0,0,.55) }
    .field{ transition: box-shadow .15s ease, border-color .15s ease }
    .field:focus{ border-color:#06C755; box-shadow: 0 0 0 4px rgba(6,199,85,.18) }
    .btn{ transition: transform .1s ease, background-color .15s ease }
    .btn:active{ transform: translateY(1px) }
  </style>
</head>
<body class="min-h-screen bg-scene flex items-center justify-center p-6">
  <main class="w-full max-w-sm">

    <!-- โลโก้บริษัท + ชื่อระบบ -->
    <header class="text-center mb-6">
      <div class="logo-badge inline-flex items-center justify-center bg-white rounded-2xl px-7 py-4 mb-5">
        <img src="<%= base %>/images/qtecLogo.png" alt="QTEC Qualitech" class="h-14 w-auto select-none" draggable="false">
      </div>
      <h1 class="text-white text-xl font-semibold tracking-tight">LINE Workflow Admin</h1>
      <p class="text-slate-400 text-sm mt-1">ระบบจัดการบอทและสรุปแชทกลุ่ม</p>
    </header>

    <!-- ฟอร์มเข้าสู่ระบบ -->
    <section class="card bg-white rounded-2xl p-6" aria-labelledby="login-title">
      <h2 id="login-title" class="text-slate-900 text-base font-semibold">เข้าสู่ระบบ</h2>
      <p class="text-slate-500 text-xs mt-0.5 mb-5">สำหรับผู้ดูแลระบบเท่านั้น</p>

      <% if (flash) { %>
        <div role="alert" class="mb-4 flex items-start gap-2 rounded-lg px-3 py-2.5 text-sm <%= flash.type === 'error' ? 'bg-red-50 text-red-700 border border-red-100' : 'bg-emerald-50 text-emerald-700 border border-emerald-100' %>">
          <span class="mt-0.5 shrink-0" aria-hidden="true"><%= flash.type === 'error' ? '⚠' : '✓' %></span>
          <span><%= flash.text %></span>
        </div>
      <% } %>

      <form method="post" action="<%= base %>/login" class="space-y-4">
        <input type="hidden" name="next" value="<%= next %>">

        <div>
          <label for="username" class="block text-xs text-slate-600 mb-1.5 font-medium">ชื่อผู้ใช้</label>
          <input id="username" name="username" autocomplete="username" required autofocus
                 placeholder="เช่น admin"
                 class="field w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none">
        </div>

        <div>
          <label for="password" class="block text-xs text-slate-600 mb-1.5 font-medium">รหัสผ่าน</label>
          <div class="relative">
            <input id="password" name="password" type="password" autocomplete="current-password" required
                   placeholder="••••••••"
                   class="field w-full px-3.5 py-2.5 pr-11 border border-slate-300 rounded-xl text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none">
            <button type="button" id="togglePassword" aria-label="แสดงรหัสผ่าน"
                    class="absolute inset-y-0 right-0 px-3 text-slate-400 hover:text-slate-600 text-xs font-medium">
              แสดง
            </button>
          </div>
        </div>

        <button class="btn w-full bg-[#06C755] hover:bg-[#05a948] text-white rounded-xl py-2.5 text-sm font-semibold shadow-sm shadow-emerald-900/20">
          เข้าสู่ระบบ
        </button>
      </form>

      <p class="text-[11px] text-slate-400 mt-5 text-center leading-relaxed">
        ค่าเริ่มต้นตั้งไว้ในไฟล์ .env (ADMIN_USERNAME / ADMIN_PASSWORD)
      </p>
    </section>

    <footer class="text-center mt-6 text-[11px] text-slate-500">
      © <%= new Date().getFullYear() + 543 %> QTEC Qualitech · LINE Workflow Automation
    </footer>
  </main>

  <script>
    // ปุ่มแสดง/ซ่อนรหัสผ่าน ช่วยลดการพิมพ์ผิดบนมือถือ
    (function () {
      var input = document.getElementById('password')
      var btn = document.getElementById('togglePassword')
      if (!input || !btn) return
      btn.addEventListener('click', function () {
        var show = input.type === 'password'
        input.type = show ? 'text' : 'password'
        btn.textContent = show ? 'ซ่อน' : 'แสดง'
        btn.setAttribute('aria-label', show ? 'ซ่อนรหัสผ่าน' : 'แสดงรหัสผ่าน')
        input.focus()
      })
    })()
  </script>
</body>
</html>
